# Anthropic Claude for article synthesis, quality checks, and revisions
ANTHROPIC_API_KEY=
LLM_MODEL_ANTHROPIC=claude-sonnet-5
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=60000
# Revisions carry the prior article plus detailed instructions and can take
# longer than initial synthesis/quality checks.
LLM_REVISION_TIMEOUT_MS=90000
PIPELINE_BUDGET_MS=270000

# Clustering thresholds
CLUSTER_MIN_SHARED_KEYWORDS=5
CLUSTER_TIME_WINDOW_HOURS=48
CLUSTER_KEYWORDS_PER_ARTICLE=12

# Article-body enrichment (fetch the real article page before synthesis)
# RSS descriptions (esp. Google News) are headline-only; without real bodies the LLM
# fabricates facts and the quality check rejects the draft. This phase resolves Google
# News redirect URLs to the publisher and downloads the article body for thin sources.
# Fetch failures retain the RSS text, but the evidence gate rejects title-only,
# irrelevant and known publisher-boilerplate bodies before synthesis.
FETCH_ARTICLE_BODIES=1
BODY_FETCH_TIMEOUT_MS=6000   # per-request timeout (page fetch / batchexecute / body fetch)
BODY_FETCH_BUDGET_MS=45000   # overall wall-clock cap for the whole enrichment phase
BODY_FETCH_MAX=40            # max number of thin sources to fetch per run
BODY_FETCH_CONCURRENCY=5     # parallel fetches during enrichment

# Cross-run near-duplicate guard (insertPipelineDrafts)
# DEDUPE_LOOKBACK_HOURS: how far back to load existing articles to compare against (default 72)
# DEDUPE_MIN_SHARED_KEYWORDS: shared keyword count (same category) that marks a draft a duplicate (default 6)
DEDUPE_LOOKBACK_HOURS=72
DEDUPE_MIN_SHARED_KEYWORDS=6

# AI editorial quality control (post-synthesis evaluation + revision loop)
# Publication must pass both the deterministic guard and Claude editorial check.
QUALITY_CHECK_ENABLED=1
QUALITY_MAX_REVISIONS=2

# Synthesis prompt structure: 主軸(核)＋肉付け方式
# Set CORE_FIRST_SYNTHESIS=1 to treat the longest-body source as the article core
# (the rest become fact-padding/cross-check only). Disabled by default = current
# flat-merge behavior (byte-identical when unset). Improves coherence when clustering
# glues together loosely-related stories.
CORE_FIRST_SYNTHESIS=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LINE Login (self-hosted OAuth flow — app/api/auth/line/*):
# We do NOT use Supabase's native custom provider for LINE. LINE signs ID tokens with
# HS256, which Supabase's OIDC verifier rejects, and its /v2/profile returns `userId`
# (not `sub`). Instead we run the LINE authorization-code flow ourselves and bridge to
# a Supabase session via the Admin API (synthetic line_*@line.invalid email + a password
# derived from LINE_SESSION_SECRET). Set the LINE channel's callback URL to
# <origin>/api/auth/line/callback (e.g. http://localhost:3000/api/auth/line/callback).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Secret used to derive each LINE user's Supabase password (HMAC). Set a stable random
# value; if unset it falls back to SUPABASE_SERVICE_ROLE_KEY. Do NOT rotate after launch
# or existing LINE users will be locked out of their accounts.
LINE_SESSION_SECRET=

# Cron + Admin API auth
CRON_SECRET=
ADMIN_API_KEY=
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
# Optional: scope the admin dashboard's Anthropic spend to a single Workspace
# (the IndoBiz workspace) instead of the whole org. Get the wrkspc_... ID from
# the Anthropic Console → Settings → Workspaces. Unset = org-wide total.
ANTHROPIC_WORKSPACE_ID=

# Optional (used by Python scraper and TS scraper fallback)
GNEWS_API_KEY=
GNEWS_QUERY=
GNEWS_LANG=en
GNEWS_COUNTRY=in

# Stripe (paid membership)
# - For local dev: use sk_test_... and run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#   (the CLI prints a whsec_... that goes into STRIPE_WEBHOOK_SECRET)
# - For prod: use sk_live_... and create a webhook endpoint in the Dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web3Forms contact form
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Image generation (replaces extracted images for copyright safety)
# IMAGE_PROVIDER: "openai" | "runware" | "none"
IMAGE_PROVIDER=openai
IMAGE_TIMEOUT_MS=90000

# OpenAI image generation (article text never uses this key)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_IMAGE_COMPRESSION=75
SUPABASE_IMAGE_BUCKET=article-images

# Runware image generation (alternate provider)
RUNWARE_API_KEY=
RUNWARE_MODEL=runware:z-image@turbo
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
